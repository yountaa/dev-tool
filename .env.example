# =============================================================================
#  dev-tool — переменные окружения
#
#  Применение:  cp .env.example .env  и заполнить под своё окружение.
#  Кто читает:  backend получает файл целиком; образу фронта нужны только
#               FRONTEND_PORT, BACKEND_URL и N8N_URL.
#
#  Формат файла: одна переменная на строку, KEY=value, без кавычек и пробелов
#  вокруг «=». Значение «по умолчанию» указано там, где переменную можно не
#  задавать вовсе.
#
#  Файл разбит на блоки:
#     1. Порты и связность          — где что слушает и кто куда ходит
#     2. Хранилище                  — Postgres или локальные файлы/git
#     3. Авторизация                — кто вошёл (oauth2-proxy + Keycloak)
#     4. RBAC                       — кому какие вкладки видны
#     5. Модуль silences            — вкладка «Silence Manager»
#     6. Модуль victoria            — вкладка «Victoria Metrics»
#     7. Модуль alerts              — вкладка «Алерты»
#
#  МИНИМУМ, чтобы приложение стартовало: хотя бы одна переменная alert_<имя>.
#  Без неё backend падает на старте с «не задано ни одного alert_* в окружении».
# =============================================================================


# =============================================================================
#  1. ПОРТЫ И СВЯЗНОСТЬ
# =============================================================================

# На каких портах публикуются контейнеры.
FRONTEND_PORT=8080                 # порт, который слушает nginx фронта
BACKEND_PORT=8000                  # порт, на котором публикуется API бэкенда

# Порт, который слушает uvicorn ВНУТРИ контейнера бэкенда.
# Менять почти никогда не нужно: наружу контейнер публикуется через BACKEND_PORT.
PORT=8000

# Куда внутренний nginx фронта проксирует API (/silences/, /victoria/, /alerts/,
# /access/, /share, /s/, /health). Браузер ходит ТОЛЬКО на фронт, а nginx
# форвардит запросы на бэкенд по этому адресу — поэтому нужен ПОЛНЫЙ адрес
# (схема://хост:порт), доступный С СЕРВЕРА ФРОНТА. Наружу бэкенд открывать
# необязательно.
# Несколько бэкендов (отказоустойчивость) — через запятую: фронт балансирует
# сам (least_conn) и временно исключает упавшую ноду.
#   один сервер / docker-compose:  http://backend:8000
#   отдельный сервер:              http://10.0.0.5:8000
#   HA-кластер бэкендов:           http://10.0.0.5:8000,http://10.0.0.6:8000
BACKEND_URL=http://backend:8000


# =============================================================================
#  2. ХРАНИЛИЩЕ  (общее: правила silences, история, короткие ссылки, alerts)
# =============================================================================

# Где приложение держит правила и историю:
#   local    — файлы на диске. Подходит для ОДНОЙ ноды приложения.
#   postgres — общая БД. Нужен, если нод несколько: они читают и пишут одну базу,
#              а шедулер координируется advisory-локом (тикает ровно одна нода).
# Модуль alerts свои метаданные пишет в Postgres независимо от этой переменной —
# ему нужны PG_* ниже (без них он просто работает без истории).
STORAGE_BACKEND=local

# --- Postgres ---------------------------------------------------------------
# Нужен при STORAGE_BACKEND=postgres и для истории модуля alerts.
# Достаточно прав на CREATE TABLE: таблицы (configs, history, short_links,
# alerts_history, alerts_meta) приложение создаёт само при старте.
# Задать можно ОДНОЙ строкой PG_DSN ЛИБО по частям — PG_DSN имеет приоритет.
# PG_DSN=postgresql://devtool:secret@pg-cluster:5432/devtool
PG_HOST=localhost                  # в docker-стенде — имя сервиса: postgres
PG_PORT=5432
PG_DB=devtool
PG_USER=devtool
PG_PASSWORD=secret

# --- Короткие ссылки на текущий вид -----------------------------------------
# Кнопка «ссылка» в шапке: POST /share сохраняет путь, GET /s/<id> редиректит.
# Хранилище выбирается тем же STORAGE_BACKEND:
#   postgres — таблица short_links, создаётся сама. Ссылки видны со ВСЕХ нод и
#              переживают выкат. Переменная ниже при этом НЕ ЧИТАЕТСЯ вообще.
#   local    — JSON-файл по пути ниже.
# Раскомментируй только если STORAGE_BACKEND=local и путь по умолчанию не подходит.
# SHORT_LINKS_FILE=./data/short_links.json


# =============================================================================
#  3. АВТОРИЗАЦИЯ  (общее для всех модулей)
# =============================================================================

# false — входа нет: имя создателя правил вводится в форме руками, а для действий
#         без формы (включить/выключить/удалить) автором пишется AUTH_FALLBACK_USER.
# true  — перед вебом стоит oauth2-proxy + Keycloak: имя берётся из заголовка
#         AUTH_USER_HEADER, поле в форме только показывается.
# ВАЖНО: RBAC (блок 4) действует ТОЛЬКО при AUTH_ENABLED=true — без входа групп
# физически нет, и резать доступ не по чему.
AUTH_ENABLED=false

# Заголовок с именем пользователя, который проставляет oauth2-proxy
# (preferred_username из Keycloak). Меняй, только если у прокси другой заголовок.
AUTH_USER_HEADER=X-Forwarded-Preferred-Username

# Имя автора, когда авторизации нет (локальная разработка).
# Если при AUTH_ENABLED=true все действия подписаны этим именем — заголовок не
# доехал до бэкенда; открой /access/debug, там будет подсказка, на каком хопе.
AUTH_FALLBACK_USER=local

# Заголовок со списком групп Keycloak (oauth2-proxy отдаёт через запятую).
# Нужен для RBAC ниже.
AUTH_GROUPS_HEADER=X-Forwarded-Groups


# =============================================================================
#  4. RBAC — какие вкладки кому видны  (общее для всех модулей)
# =============================================================================
#
#  Права выдаются на МОДУЛЬ (вкладку) целиком — уровня окружения нет.
#  id модулей: silences, victoria, alerts.
#
#  Правила:
#    • RBAC_ENABLED=false           → всем видно всё (по умолчанию);
#    • модуль без своей access_*    → виден всем;
#    • access_<module>=g1,g2        → видят участники любой из групп (логика OR);
#    • access_<module>=*            → вкладка открыта ВСЕМ вошедшим, включая
#                                     пользователя вообще без групп;
#    • RBAC_ADMIN_GROUP=g1,g2       → эти группы видят ВСЕ вкладки. Здесь «*» НЕ
#                                     работает — только буквальные имена групп.
#
#  Имена групп сверяются ТОЧНО: регистр и ведущий слэш важны (Keycloak часто
#  отдаёт «/team-oncall», а не «team-oncall»). Что реально приходит — видно в
#  GET /access/me, поле groups.
#
#  Защита двойная: бэкенд отдаёт 403 на API чужого модуля, фронт прячет вкладку.
# -----------------------------------------------------------------------------
RBAC_ENABLED=false
RBAC_ADMIN_GROUP=observability-admins,platform-admins
access_silences=team-oncall,team-sre
access_victoria=team-metrics
access_alerts=*


# =============================================================================
#  5. МОДУЛЬ silences — вкладка «Silence Manager»
#
#  Ставит silence в Alertmanager: разово по датам и по расписанию. Правила и
#  историю хранит в git или Postgres (см. блок 2), шедулер дочиняет недостающие
#  silence по расписаниям.
# =============================================================================

# --- Окружения = вкладки окружения (ОБЯЗАТЕЛЬНО хотя бы одна) ----------------
#  Формат:  alert_<имя>=<url>[,<url2>...]
#  Каждая переменная даёт отдельную вкладку окружения. Имя (после alert_)
#  приводится к нижнему регистру. URL наружу не отдаются — только имена.
#  HA: несколько нод через запятую — читаем со всех, silence пишем на первую
#  живую (кластер Alertmanager разносит его по gossip сам).
alert_dev=http://alertmanager.dev.svc:9093
alert_prod=http://am-1.prod.svc:9093,http://am-2.prod.svc:9093

# --- Источник определений алертов (Prometheus или vmalert) -------------------
#  Формат:  rules_<имя>=<url>[,<url2>...]   — <имя> совпадает с alert_<имя>.
#  Берётся через GET /api/v1/rules: список показывает ВСЕ правила, а Alertmanager
#  помечает, какие сейчас горят или заглушены. Несколько нод — через запятую.
#  Необязательно: без переменной вкладка показывает только живые алерты из AM.
#  Имя, не совпадающее ни с одним alert_*, приложение пишет в лог как warning.
rules_dev=http://prometheus.dev.svc:9090
rules_prod=http://vmalert-1.prod.svc:8880,http://vmalert-2.prod.svc:8880

# --- Папка локального хранилища  (используется при STORAGE_BACKEND=local) ----
#  Правила лежат файлами <env>/<kind>/<id>.json, журнал изменений —
#  <env>/history/history.ndjson, удалённые правила — <env>/old/.
#  Папку нужно вынести на постоянный том: при пересоздании контейнера всё, что
#  лежит внутри образа, теряется.
GIT_LOCAL_DIR=./.hub-repo

# --- Шедулер расписаний ------------------------------------------------------
SILENCE_CRON=*/5 * * * *           # как часто проверять расписания и синхронизировать git
# Таймзона, в которой задаются окна расписания И показываются даты во всём вебе
# (Alertmanager внутри работает в UTC — перевод делает приложение).
SILENCE_TZ=Europe/Moscow

# --- Авто-очистка ------------------------------------------------------------
# Три независимых параметра: КОГДА чистить и два срока хранения.
CLEANUP_CRON=0 3 1 * *             # расписание очистки (по умолч. 1-го числа в 03:00)
HISTORY_RETENTION_DAYS=30          # сколько дней хранить журнал истории (кто/что менял)
DELETED_RULES_RETENTION_DAYS=30    # сколько дней хранить мягко удалённые правила


# =============================================================================
#  6. МОДУЛЬ victoria — вкладка «Victoria Metrics»
#
#  Тонкий прокси к кластерам VM. Каждый КЛАСТЕР = одна вкладка, имя <env> после
#  префикса = название вкладки (приводится к нижнему регистру). Несколько нод
#  компонента (HA) — через запятую, читаем с первой живой.
#
#  Какая переменная какую под-вкладку включает:
#    vm_<env>       → Graph и TSDB Status   ОБЯЗАТЕЛЬНА для вкладки. Адрес
#                     vmselect, Prometheus-совместимый; обычно оканчивается на
#                     /select/<accountID>/prometheus
#    vmagent_<env>  → Targets               опционально, адрес vmagent
#    vmalert_<env>  → Rules                 опционально, адрес vmalert
#  Нет vmagent_/vmalert_ → соответствующей под-вкладки просто не будет.
#  Под-вкладка Disk Usage сводная — считается по всем кластерам сразу.
#
#  Имена переменных — только [A-Za-z0-9_]: дефис docker молча выбросит. Двоеточие
#  в accountID (например 5:2) допустимо — оно в ЗНАЧЕНИИ, а не в имени.
# =============================================================================

# --- Полный стек Victoria Metrics: будут все под-вкладки ---------------------
vm_dev=http://vmselect.dev.svc:8481/select/0/prometheus       # Graph + TSDB Status
vmagent_dev=http://vmagent.dev.svc:8429                       # Targets
vmalert_dev=http://vmalert.dev.svc:8880                       # Rules

# --- Боевой кластер в HA: несколько vmselect через запятую -------------------
vm_prod=http://vmselect-1.prod.svc:8481/select/0/prometheus,http://vmselect-2.prod.svc:8481/select/0/prometheus
vmagent_prod=http://vmagent.prod.svc:8429
vmalert_prod=http://vmalert.prod.svc:8880

# --- Кластер ТОЛЬКО под хранение: без vmagent/vmalert ------------------------
# Будут только Graph и TSDB Status, вкладок Targets/Rules у него не появится.
vm_store=http://vmselect.store.svc:8481/select/0/prometheus

# --- Prometheus-стек, метрики лежат в Victoria Metrics -----------------------
# Prometheus скрейпит и remote_write'ит в VM. Метрики читаем из VM, а Targets и
# Rules берём у самого Prometheus — он отдаёт /api/v1/targets и /api/v1/rules.
vm_promstack=http://vmselect.svc:8481/select/0/prometheus     # Graph + TSDB Status (из VM)
vmagent_promstack=http://prometheus.svc:9090                  # Targets ← Prometheus
vmalert_promstack=http://prometheus.svc:9090                  # Rules   ← Prometheus

# --- Один кластер под одним именем в разных модулях --------------------------
# Модули независимы, но одинаковый суффикс имени даёт вкладку «prod» и в Silence
# Manager, и в Victoria Metrics — удобно держать кластер под одним именем везде:
#   alert_prod=...   rules_prod=...   vm_prod=...   vmagent_prod=...


# =============================================================================
#  7. МОДУЛЬ alerts — вкладка «Алерты»
#
#  Конфигурацию алертов ведёт n8n: фронт ходит на /webhook/... (CRUD/preview),
#  внутренний nginx проксирует эти запросы в n8n. Lookup fields/indices идёт
#  через бэкенд (/alerts/fields, /alerts/indices) с TTL-кэшем в Postgres —
#  теми же PG_* из блока 2; без них кэш выключен, запросы идут в n8n напрямую.
#  История и зеркало конфигов тоже в Postgres.
# =============================================================================

# Куда внутренний nginx фронта проксирует /webhook/ — ORIGIN n8n, БЕЗ хвостового
# /webhook: путь запроса уходит как есть (/webhook/alerts → N8N_URL/webhook/alerts).
# ОБЯЗАТЕЛЬНА для образа фронта: nginx подставляет её в конфиг при старте.
# Бэкенд alerts тоже читает N8N_URL — для lookup fields/indices с кэшем в Postgres.
N8N_URL=http://n8n:5678

# Тот же адрес для dev-сервера Vite (`vite.config.js`). В контейнере не читается.
N8N_ORIGIN=http://localhost:5678

# TTL кэша справочников ELK в Postgres (fields / indices). Без PG_* кэш просто
# выключен — каждый запрос идёт в n8n.
ALERTS_FIELDS_CACHE_TTL_SECONDS=3600   # 1 час — поля индекса меняются редко
ALERTS_INDICES_CACHE_TTL_SECONDS=900   # 15 минут — новые индексы появляются чаще
